# ==============================================================================
# CAMPUSFIX MOBILE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file or pass these build flags when compiling or running the app:
#
# Flutter compile-time define usage:
#   flutter run --dart-define=ENVIRONMENT=production
#   flutter run --dart-define=API_BASE_URL=https://campusfixed.netlify.app/api/v1
#   flutter run --dart-define=GOOGLE_SERVER_CLIENT_ID=440612845967-ggac7dh53iktbpo8t38qaj392kp5kk5v.apps.googleusercontent.com
#
# DO NOT COMMIT REAL CREDENTIALS, CLIENT SECRETS, OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# Target deployment environment: 'production', 'staging', or 'development'
# Default: production (so the app connects out-of-the-box to CampusFix backend)
ENVIRONMENT=production

# Base URL for custom CampusFix versioned application endpoints (REST API v1)
# Production: https://campusfixed.netlify.app/api/v1
# Development (Android Emulator): http://10.0.2.2:5000/api/v1
# Development (Physical Device): http://<YOUR_LOCAL_IP>:5000/api/v1
API_BASE_URL=https://campusfixed.netlify.app/api/v1

# Optional override for Better Auth authentication base URL.
# If omitted, automatically derived as '${origin}/api/auth' from API_BASE_URL.
# Default: https://campusfixed.netlify.app/api/auth
AUTH_BASE_URL=https://campusfixed.netlify.app/api/auth

# Google OAuth Web Client ID (Public Identifier - Safe to distribute in client config)
# Used as the audience (serverClientId) when requesting Google OIDC ID tokens on mobile
# so that the backend Better Auth service can cryptographically verify the token.
GOOGLE_SERVER_CLIENT_ID=440612845967-ggac7dh53iktbpo8t38qaj392kp5kk5v.apps.googleusercontent.com

# Optional Google Client ID override (typically only used on Web/iOS; Android resolves
# client registration automatically via package name com.campusfix.app and signing SHA-1)
GOOGLE_CLIENT_ID=
